<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F0E8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Pharmacy name -->
        <TextView
            android:id="@+id/tvPharmacyName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#0D5E8A"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Address -->
        <TextView
            android:id="@+id/tvPharmacyAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#555555"
            android:textSize="14sp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#DDDDDD" />

        <!-- Travel time -->
        <TextView
            android:id="@+id/tvTravelTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#333333"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Distance -->
        <TextView
            android:id="@+id/tvDistance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#555555"
            android:textSize="15sp" />

        <!-- Traffic status row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/viewTrafficDot"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@drawable/circle_green" />

            <TextView
                android:id="@+id/tvTrafficStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#444444"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Spacer -->
        <View android:layout_width="match_parent" android:layout_height="32dp" />

        <!-- Navigate button -->
        <Button
            android:id="@+id/btnNavigate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#00A896"
            android:text="Navigasyonu Başlat"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Call button -->
        <Button
            android:id="@+id/btnCall"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#0D5E8A"
            android:text="Eczaneyi Ara"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
